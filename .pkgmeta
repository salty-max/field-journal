# The BigWigs packager's settings (.github/workflows/release.yml). The addon
# is addon/Yonder, shipped as it is (one zip for every game: each loads
# its own TOC); the rest of the repository stays out (the release checks the
# package is the folder, nothing more). The notes are the tag's message,
# written to .release-notes.md by the workflow.
package-as: Yonder

# With it, the handover from the old name, addon/FieldJournal (Classic Era and
# TBC TOCs only: scripts/package.ts checks it).
move-folders:
  Yonder/addon/Yonder: Yonder
  Yonder/addon/FieldJournal: FieldJournal

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - addon/test
  - addon/CURSEFORGE.md
  - assets
  - atlas
  - content
  - data
  - docs
  - i18n
  - expeditions
  - notes
  - scripts
  - CLAUDE.md
  - LICENSE
  - PLAN.md
  - README.md
  - package.json
  - selene.toml
  - stylua.toml
  - wow.yml

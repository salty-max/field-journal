# The BigWigs packager's settings (.github/workflows/release.yml). The addon
# is addon/FieldJournal, shipped as it is (one zip for every game: each loads
# its own TOC); the rest of the repository stays out (the release checks the
# package is the folder, nothing more). The notes are the tag's message,
# written to .release-notes.md by the workflow.
package-as: FieldJournal

move-folders:
  FieldJournal/addon/FieldJournal: FieldJournal

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - addon/test
  - addon/CURSEFORGE.md
  - assets
  - atlas
  - content
  - data
  - docs
  - notes
  - scripts
  - CLAUDE.md
  - LICENSE
  - PLAN.md
  - README.md
  - package.json
  - selene.toml
  - stylua.toml
  - wow.yml
